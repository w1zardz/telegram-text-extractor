{
  "manifest_version": 3,
  "name": "Telegram Text Extractor — Copy from Protected Channels",
  "short_name": "TG Text Extractor",
  "version": "1.1.1",
  "description": "Copy text from Telegram Web K and A even when copying is disabled. Collect channel history, bulk copy, search, export to .txt / .json.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Telegram Text Extractor — toggle panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "permissions": [
    "clipboardWrite",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://web.telegram.org/*"
  ],
  "homepage_url": "https://github.com/w1zardz/extractor"
}
